# Rename this file to .env and fill in your key
GEMINI_API_KEY=your_gemini_api_key_here

# Model used by the Code Exec Agent for reasoning + vision (image -> code OCR)
GEMINI_MODEL=gemini-3.6-flash

# Optional: Piston (https://github.com/engineer-man/piston) - kept as a secondary
# code-execution option. NOTE: as of Feb 2026 the free public Piston API requires
# an authorized key from the maintainer, so it's NOT usable out of the box anymore.
# The default executor below (Judge0) needs no such approval.
PISTON_URL=https://emkc.org/api/v2/piston

# Which sandbox actually runs the code: "judge0" (default, recommended) or "piston"
CODE_EXECUTOR=judge0

# Judge0 (https://judge0.com) via RapidAPI's free tier - 50 requests/day, no card
# needed. Get a key: sign up free at rapidapi.com, then subscribe to the "Judge0 CE"
# API's Basic/Free plan at rapidapi.com/judge0-official/api/judge0-ce, and copy the
# X-RapidAPI-Key shown on that page.
JUDGE0_API_KEY=your_rapidapi_key_here
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# RAG pipeline (backend/rag/) - uses the same GEMINI_API_KEY above, no extra key
# needed.
RAG_EMBEDDING_MODEL=models/gemini-embedding-001

# Used to sign login session tokens - set this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
